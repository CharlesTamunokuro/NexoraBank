generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  RESTRICTED
  SUSPENDED
  CLOSED
}

enum VerificationStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  NEEDS_INFORMATION
  REJECTED
}

enum AccountStatus {
  OPEN
  RESTRICTED
  SUSPENDED
  CLOSED
}

enum TransferStatus {
  PENDING_REVIEW
  INFORMATION_REQUESTED
  REJECTED
  CANCELLED
  COMPLETED_INTERNAL
}

enum TransactionKind {
  ACCOUNT_FUNDING
  INTERNAL_TRANSFER
  DOMESTIC_REQUEST
  INTERNATIONAL_REQUEST
}

model User {
  id                 String               @id @default(cuid())
  customerNumber     String               @unique
  firstName          String
  middleName         String?
  lastName           String
  email              String               @unique
  phone              String
  passwordHash       String
  dateOfBirth        DateTime?
  address            String?
  apartment          String?
  city               String?
  state              String?
  postalCode         String?
  country            String               @default("United States")
  citizenship        String?
  employment         String?
  occupation         String?
  incomeRange        String?
  accountPurpose     String?
  status             UserStatus           @default(ACTIVE)
  verificationStatus VerificationStatus   @default(PENDING)
  adminNote          String?
  lastLoginAt        DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  accounts           Account[]
  beneficiaries      Beneficiary[]
  transfers          Transfer[]
  notifications      Notification[]
  transactions       Transaction[]
  pin                TransactionPin?
  pinAttempts        PinAttempt[]

  @@index([lastName, firstName])
  @@index([status, verificationStatus])
}

model Account {
  id                 String        @id @default(cuid())
  userId             String
  accountNumber      String        @unique
  name               String
  type               String        @default("Checking")
  currency           String        @default("USD")
  ledgerBalance      Decimal       @default(0) @db.Decimal(19, 2)
  reservedBalance    Decimal       @default(0) @db.Decimal(19, 2)
  status             AccountStatus @default(OPEN)
  statusBeforeUserSuspension AccountStatus?
  restrictionReason  String?
  internalNote       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  user               User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions       Transaction[]
  outgoingEntries    LedgerEntry[] @relation("LedgerAccount")
  transfers          Transfer[]    @relation("SourceAccount")
  beneficiaries      Beneficiary[]
  fundingRecords     FundingRecord[]

  @@index([userId, status])
}

model Transaction {
  id            String         @id @default(cuid())
  reference     String         @unique
  userId        String
  accountId     String
  transferId    String?
  kind          TransactionKind
  description   String
  amount        Decimal        @db.Decimal(19, 2)
  fee           Decimal        @default(0) @db.Decimal(19, 2)
  currency      String         @default("USD")
  status        String         @default("RECORDED")
  adminNote     String?
  createdAt     DateTime       @default(now())
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Restrict)
  transfer      Transfer?      @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([transferId])
}

model LedgerEntry {
  id             String   @id @default(cuid())
  operationKey   String
  accountId      String?
  ledgerCode     String
  amount         Decimal  @db.Decimal(19, 2)
  currency       String   @default("USD")
  entryType      String
  description    String
  createdAt      DateTime @default(now())
  account        Account? @relation("LedgerAccount", fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([operationKey, ledgerCode])
  @@index([accountId, createdAt])
}

model Transfer {
  id                  String         @id @default(cuid())
  reference           String         @unique
  userId              String
  sourceAccountId     String
  recipientName       String
  recipientBank       String
  recipientAccount    String
  recipientCountry    String?
  recipientCurrency   String         @default("USD")
  swiftBic             String?
  description          String?
  kind                 String
  amount               Decimal        @db.Decimal(19, 2)
  fee                  Decimal        @default(0) @db.Decimal(19, 2)
  status               TransferStatus @default(PENDING_REVIEW)
  reviewStatus         String         @default("NOT_REVIEWED")
  reviewNote           String?
  reviewUpdatedAt      DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  user                 User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  sourceAccount        Account        @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  transactions         Transaction[]
  reviews              TransferReview[]
  idempotencyKey       String?        @unique

  @@index([userId, createdAt])
  @@index([status, kind, createdAt])
}

model TransferReview {
  id          String   @id @default(cuid())
  transferId  String
  adminId     String
  action      String
  note        String?
  createdAt   DateTime @default(now())
  transfer    Transfer @relation(fields: [transferId], references: [id], onDelete: Restrict)
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([transferId, createdAt])
}

model Beneficiary {
  id                String   @id @default(cuid())
  userId            String
  accountId         String?
  name              String
  nickname          String?
  bankName          String
  accountNumber     String
  country           String?
  currency          String   @default("USD")
  swiftBic          String?
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  account           Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Admin {
  id            String          @id @default(cuid())
  email         String          @unique
  displayName   String
  passwordHash  String
  role          String          @default("OPERATIONS")
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  funding       FundingRecord[]
  auditLogs     AuditLog[]
  reviews       TransferReview[]
}

model FundingRecord {
  id             String   @id @default(cuid())
  reference      String   @unique
  idempotencyKey String   @unique
  accountId      String
  adminId        String
  amount         Decimal  @db.Decimal(19, 2)
  currency       String   @default("USD")
  category       String
  internalReference String?
  description    String
  internalNote   String?
  createdAt      DateTime @default(now())
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  admin          Admin    @relation(fields: [adminId], references: [id], onDelete: Restrict)
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  title      String
  body       String
  readAt     DateTime?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}

model TransactionPin {
  userId        String   @id
  pinHash       String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  lockedUntil   DateTime?
  failedAttempts Int     @default(0)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PinAttempt {
  id         String   @id @default(cuid())
  userId     String
  succeeded  Boolean
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  targetType  String
  targetId    String
  reason      String
  createdAt   DateTime @default(now())
  admin       Admin    @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([adminId, createdAt])
  @@index([targetType, targetId])
}
